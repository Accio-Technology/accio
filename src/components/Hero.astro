---

<section class="hero">
    <div class="container">
        <div class="hero-grid">
            <div>
                <div class="hero-tag">
                    <span>⚡ Custom Web Design &amp; Subscription-Free Hosting</span>
                </div>
                <h1>Custom Business Websites Built For Maximum Speed.</h1>
                <p>Whether you're launching a brand-new business or migrating an existing website off Wix, Squarespace, or Shopify, we build custom sites on high-performance cloud infrastructure with <strong>zero monthly website builder fees</strong>.</p>
                <div class="hero-cta-group">
                    <a href="#contact" class="btn btn-primary">Start Your Website Project</a>
                    <a href="#solutions" class="btn btn-secondary">Explore Options</a>
                </div>
                <div class="stats-strip">
                    <div class="stat-item">
                        <h4>95+</h4>
                        <p>Google PageSpeed Guarantee</p>
                    </div>
                    <div class="stat-item">
                        <h4>$0/mo</h4>
                        <p>Ongoing Builder Subscriptions</p>
                    </div>
                    <div class="stat-item">
                        <h4>100%</h4>
                        <p>Full Code Ownership</p>
                    </div>
                </div>
            </div>

            <!-- Hero Interactive Visual -->
            <div class="hero-card">
                <h3>Target Web Performance</h3>
                <div class="speed-score">
                    <div class="score-circle">99</div>
                    <p>Google Mobile Core Web Vitals</p>
                </div>
                <div class="score-details">
                    <div class="score-row">
                        <span>Website Builder Subscription:</span>
                        <span class="value">$0/mo (No Rent Fees)</span>
                    </div>
                    <div class="score-row">
                        <span>Page Load Speed:</span>
                        <span class="value">0.4 Seconds</span>
                    </div>
                    <div class="score-row">
                        <span>SEO Health Score:</span>
                        <span class="value-green">100 / 100</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>